# Copiar a .env y cargar antes de desplegar:  set -a && source .env && set +a
# Credenciales del Learner Lab (AWS Details → AWS CLI). Caducan cada sesión (~4 h).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Rol preexistente del Learner Lab (no se pueden crear roles IAM)
LAB_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/LabRole

STAGE=dev

# Opcional. No lo lee serverless.yml directamente; pásalo como
#   --param="cognitoUserPoolArn=$COGNITO_USER_POOL_ARN"
# Vacío => endpoints sin authorizer.
COGNITO_USER_POOL_ARN=

# ── Seeding (scripts/seed_master.py) ──
# RDS PostgreSQL (si DB_HOST queda vacío, core_hr y payroll fallan con mensaje claro y el resto sigue)
DB_HOST=
DB_PORT=5432
DB_NAME=hcm_db
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
# Opcionales: SEED_REFERENCE_DATE=2026-11-09  SEED_TENANTS=tenant_a,tenant_b,tenant_c  SCHEMA_TENANT_A=tenant_a
