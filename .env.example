# Copiar a .env y cargar antes de desplegar:  set -a && source .env && set +a
# Credenciales del Learner Lab (AWS Details → AWS CLI). Caducan cada sesión (~4 h).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Rol preexistente del Learner Lab (no se pueden crear roles IAM)
LAB_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/LabRole

STAGE=dev

# Authorizer: attendance lo toma del stack hcm-auth-${STAGE} (output AuthorizerArn); no hay que configurar nada.
# Login de los usuarios demo (solo para los curl de prueba del README):
AUTH_API=https://0kcyrpixu6.execute-api.us-east-1.amazonaws.com/dev

# ── Seeding (scripts/seed_master.py) ──
# RDS PostgreSQL (si DB_HOST queda vacío, core_hr y payroll fallan con mensaje claro y el resto sigue)
DB_HOST=
DB_PORT=5432
DB_NAME=hcm_db
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
# Usuarios demo (tenants + employeeId que usa el seeding). Default: scripts/users.json
# SEED_USERS_FILE=scripts/users.json
# Opcionales: SEED_REFERENCE_DATE=2026-11-09  SEED_TENANTS=tenant_a,tenant_b  SCHEMA_TENANT_A=tenant_a
